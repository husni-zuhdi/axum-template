APP_DATABASE_URL=":memory:"
# Generate with: echo -n "yourpassword" | argon2 "$(openssl rand -base64 32)" -e -id -t 2 -m 14 -p 1
# Values containing $ MUST use single quotes (dotenvy interpolates $ otherwise).
APP_PASSWORD_HASH='REPLACE_WITH_ARGON2_HASH'
# Required when APP_DATABASE_URL is a remote Turso/libsql URL (libsql://... or https://...)
APP_TURSO_TOKEN="your.turso.token"
APP_ADDRESS="0.0.0.0"
APP_PORT="3000"
RUST_LOG=info
